# =====================================================================
# ChatKita — environment produksi (Opsi A: VPS + systemd)
# Salin ke /opt/chatkita/deploy/chatkita.env lalu sesuaikan:
#   cp deploy/chatkita.env.example deploy/chatkita.env && nano deploy/chatkita.env
# Kedua unit systemd membaca file ini (EnvironmentFile).
# =====================================================================

# Database web (Prisma) — path absolut
DATABASE_URL=file:/opt/chatkita/db/custom.db

# ⚠️ WAJIB GANTI! Sandi panel admin (/?admin). Default bawaan kode: admin123
ADMIN_PASSWORD=ganti-dengan-kata-sandi-kuat

# Retensi media global (hari). 0 = tidak pernah kedaluwarsa (bisa diatur per-jenis/per-chat dari panel admin)
MEDIA_RETENTION_DAYS=0
