# =====================================================================
# ChatKita Chat — socket.io + bun:sqlite, port 3003 (hard-coded)
# Pasang:  sudo cp deploy/chatkita-chat.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now chatkita-chat
# =====================================================================
[Unit]
Description=ChatKita Chat Service (socket.io, port 3003)
After=network.target

[Service]
Type=simple
User=chatkita
Group=chatkita
WorkingDirectory=/opt/chatkita/mini-services/chat-service
EnvironmentFile=/opt/chatkita/deploy/chatkita.env
# TANPA --hot: mode produksi (bukan dev)
ExecStart=/usr/local/bin/bun index.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
